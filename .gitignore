# Publish only reviewed project paths; play, private evidence and history stay local.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/LICENSE
!/COPYRIGHT.md
!/AI_DISCLOSURE.md
!/docs/
/docs/*
!/docs/*.md
!/development/
/development/*
!/development/mojin.mk
!/development/ge-replay.mk
!/development/Start-Visible-Battle.cmd
!/development/tools/
/development/tools/*
!/development/tools/*.py
!/development/runtime/
/development/runtime/*
!/development/runtime/*.c
!/development/runtime/*.h
!/development/assets/
/development/assets/*
!/development/assets/game.rc
!/development/assets/game.ico
!/development/assets/icon-provenance.json
!/development/assets/disc-manifest.json
!/development/assets/pipeline-catalog.json
!/development/assets/cjk-font-provenance.json
!/development/inputs/
/development/inputs/*
!/development/inputs/dispatch-seeds.txt
!/development/prepared/
/development/prepared/*
!/development/prepared/game/
/development/prepared/game/*
!/development/prepared/game/manifest.json
!/development/prepared/game/mojin_recomp*.c
!/development/prepared/game/mojin_recomp_funcs.h
!/development/prepared/game/mojin_recomp_opt.mk
!/development/prepared/game/mojin_recomp_coverage.json
!/development/prepared/game/mojin_recomp_stubs.txt
!/development/prepared/game/mojin_image.bin
!/development/prepared/game/mojin_imports.toml
!/development/resources/
/development/resources/*
!/development/resources/game/
!/development/third_party/
/development/third_party/*
!/development/third_party/nakagawa/
!/development/tests/
/development/tests/*
!/development/tests/*.c
!/development/tests/*.pad

# Raw containers, native binaries, private keys and captures remain excluded.
*.iso
*.ISO
*.cso
*.pbp
*.zip
*.7z
*.exe
*.dll
*.elf
*.o
*.d
*.pdb
*.wav
*.ppm
*.bmp
*.ngef
.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
